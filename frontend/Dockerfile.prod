# Production frontend image, used by docker-compose.dokploy.yml on the Dokploy VM.
#
# The original ./Dockerfile runs `npm run dev` (a Vite dev server) and the
# Windows-host compose bind-mounts the source over it. Neither works under
# Dokploy: it re-clones the repo on every deploy, which gives every path a new
# inode, so bind-mounted source silently goes stale.
#
# VITE_API_URL is a BUILD-time value -- Vite inlines import.meta.env at build,
# so it cannot be supplied as a runtime environment variable.

FROM node:18-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

# Deliberately EMPTY. api.js then uses a relative base, so requests are always
# same-origin -- no CORS, and the app works under every hostname it is served
# on: hsr-intelligence.home via Traefik, and 192.168.1.47:8653 /
# 100.120.218.121:8653 via the published port.
#
# An absolute URL here would be baked into the bundle at build time and break
# IP access: the page loads, then every API call goes to that one hostname,
# which phones and off-LAN clients cannot resolve.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
